rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function userDoc() { return get(profilePath()); }
    function role() { return hasProfile() ? userDoc().data.role : 'viewer'; }
    function isActive() { return hasProfile() && userDoc().data.status == 'active'; }
