rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function hasProfile() { return signedIn() && exists(profilePath()); }
    function userDoc() { return get(profilePath()); }
    function role() { return hasProfile() ? userDoc().data.role : 'viewer'; }
    function isActive() { return hasProfile() && userDoc().data.status == 'active'; }
    function isSuperuser() { return isActive() && (role() in ['admin','dawood','moatasem']); }
    function isGeneralManager() { return isActive() && role() == 'general_manager'; }
    function isFinance() { return isActive() && (role() in ['admin','finance_user','dawood','moatasem','accountant']); }
    function isWarehouse() { return isActive() && (role() in ['admin','warehouse_manager','manufacturing_manager','dawood','moatasem']); }
    function isSales() { return isActive() && (role() in ['admin','sales_rep','dawood','moatasem','finance_user']); }
    function ownsUser(userId) { return signedIn() && request.auth.uid == userId; }
    function ownEmail() { return signedIn() && resource.data.email == request.auth.token.email; }
    function canViewAll() { return isSuperuser() || isGeneralManager(); }
    function affectedOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function safeOwnLoginPatch(userId) { return (ownsUser(userId) || ownEmail()) && affectedOnly(['lastLogin','updatedAt','updatedBy']); }
    function safeFinancialPatch() { return isActive() && affectedOnly(['cashBalance','cliqBalance','advancesBalance','salaryBalance','lastLogin','updatedAt','updatedBy']); }

    match /loginAliases/{username} {
      allow read: if true;
      allow create, update: if isSuperuser();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if isActive();
      allow create: if isSuperuser();
      allow update: if isSuperuser() || safeOwnLoginPatch(userId) || safeFinancialPatch();
      allow delete: if false;
    }

    match /settings/{docId} { allow read: if signedIn(); allow write: if isSuperuser(); }
    match /roles/{docId} { allow read: if signedIn(); allow write: if isSuperuser(); }
    match /permissions/{docId} { allow read: if signedIn(); allow write: if isSuperuser(); }

    match /warehouses/{docId} { allow read: if isActive(); allow write: if isWarehouse(); allow delete: if false; }
    match /items/{docId} { allow read: if isActive(); allow write: if isWarehouse(); allow delete: if false; }
    match /inventoryMovements/{docId} { allow read: if isActive(); allow create, update: if isWarehouse() || role() == 'sales_rep'; allow delete: if false; }
    match /stockCounts/{docId} { allow read: if isActive(); allow create, update: if isWarehouse() || isFinance(); allow delete: if false; }

    match /manufacturingRecipes/{docId} { allow read: if isActive(); allow write: if isSuperuser() || role() == 'manufacturing_manager'; allow delete: if false; }
    match /productionOrders/{docId} { allow read: if isActive(); allow create, update: if isSuperuser() || role() == 'manufacturing_manager'; allow delete: if false; }

    match /customers/{docId} { allow read: if isSales() || isFinance() || isGeneralManager(); allow create: if isSuperuser(); allow update: if isSuperuser() || ((isSales() || isFinance()) && affectedOnly(['currentBalance','updatedAt','updatedBy'])); allow delete: if false; }
    match /salesInvoices/{docId} { allow read: if isSales() || isFinance() || isGeneralManager(); allow create, update: if isSales() || isSuperuser(); allow delete: if false; }
    match /customerDebts/{docId} { allow read: if isSales() || isFinance() || isGeneralManager(); allow create, update: if isSales() || isFinance(); allow delete: if false; }
    match /collections/{docId} { allow read: if isSales() || isFinance() || isGeneralManager(); allow create, update: if isSales() || isFinance(); allow delete: if false; }

    match /suppliers/{docId} { allow read: if isFinance() || isWarehouse() || isGeneralManager() || role() == 'sales_rep'; allow create, update: if isFinance() || isWarehouse(); allow delete: if false; }
    match /purchaseInvoices/{docId} { allow read: if isFinance() || isWarehouse() || isGeneralManager() || role() == 'sales_rep'; allow create, update: if isFinance() || isWarehouse(); allow delete: if false; }
    match /supplierDebts/{docId} { allow read: if isFinance() || isGeneralManager() || role() == 'sales_rep'; allow create, update: if isFinance(); allow delete: if false; }

    match /cashDeliveries/{docId} { allow read: if isFinance() || role() == 'sales_rep' || isGeneralManager(); allow create: if isFinance() || role() == 'sales_rep'; allow update: if isFinance() || role() == 'sales_rep'; allow delete: if false; }
    match /internalTransfers/{docId} { allow read: if isActive(); allow create, update: if isFinance() || role() == 'sales_rep'; allow delete: if false; }
    match /employeeAdvances/{docId} { allow read: if isFinance() || isSuperuser() || isGeneralManager() || role() == 'sales_rep'; allow create, update: if isFinance() || isSuperuser() || role() == 'sales_rep'; allow delete: if false; }
    match /salaries/{docId} { allow read: if isFinance() || isSuperuser() || isGeneralManager() || role() == 'sales_rep'; allow create, update: if isFinance() || isSuperuser(); allow delete: if false; }
    match /vehicleExpenses/{docId} { allow read: if isFinance() || role() == 'sales_rep' || isGeneralManager(); allow create, update: if isFinance() || role() == 'sales_rep'; allow delete: if false; }

    match /systemLogs/{docId} {
      allow read: if isSuperuser() || isGeneralManager() || role() == 'sales_rep';
      allow create: if signedIn();
      allow update, delete: if false;
    }
    match /notifications/{docId} { allow read: if isActive(); allow create, update: if isActive(); allow delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
